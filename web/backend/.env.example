# === .env.example ===

# Aplicación
APP_NAME=ElCampesino
APP_ENV=development          # development | production | testing
DEBUG=true

# Base de datos
# SQLite (desarrollo)
DATABASE_URL=sqlite:///./el_campesino.db
# PostgreSQL (producción)
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/elcampesino_db
# MySQL (alternativa)
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/elcampesino_db

# Seguridad
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# 129600 minutos = 90 días (mantiene la sesión activa en la app móvil)
JWT_EXPIRATION_MINUTES=129600

# Servidor
HOST=0.0.0.0
PORT=8000

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000
